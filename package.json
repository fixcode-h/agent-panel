{
  "name": "agent-panel",
  "version": "0.29.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "本机 Agent 任务面板：按项目分类编排 Codex / Claude Code 等本地 Agent",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config config/vite.config.ts",
    "build": "vite build --config config/vite.config.ts",
    "build:demo": "vite build --mode demo --config config/vite.config.ts",
    "format": "prettier --write --config config/.prettierrc.json --ignore-path .gitignore --ignore-path config/.prettierignore web/src server shared scripts config extension \"docs/**/*.md\" \"skills/**/*.md\" \"README*.md\" CONTRIBUTING.md",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc -b && node scripts/i18n-check.mjs",
    "lint": "oxlint -c config/.oxlintrc.json --deny-warnings --ignore-pattern dist --ignore-pattern dist-demo --ignore-pattern release --ignore-pattern build --ignore-pattern ui-shots --ignore-pattern \"server/exec/fixtures/**\" && prettier --check --config config/.prettierrc.json --ignore-path .gitignore --ignore-path config/.prettierignore --cache --cache-location .tmp/prettier-cache web/src server shared scripts config extension \"docs/**/*.md\" \"skills/**/*.md\" \"README*.md\" CONTRIBUTING.md && node scripts/rules-check.mjs && node scripts/secret-check.mjs && node scripts/test-budget.mjs --check",
    "check:secrets": "node scripts/secret-check.mjs",
    "lessons": "node scripts/lessons.mjs",
    "docs:bugs": "node scripts/doc-bugs.mjs",
    "docs:bugs:check": "node scripts/doc-bugs.mjs --check",
    "docs:modules": "node scripts/doc-modules.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:wsl": "wsl -e bash -lc \"npm run test:e2e\"",
    "test:unit": "node scripts/unit-tests.mjs",
    "bench:tables": "node node_modules/tsx/dist/cli.mjs scripts/bench-tables.ts",
    "test:failed": "node scripts/unit-tests.mjs --failed",
    "test:affected": "node scripts/changed-tests.mjs --run",
    "eval:real": "node --import tsx scripts/real-cli/eval.mjs",
    "test:coverage": "tsx --test --experimental-test-coverage \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@automann/maple-mono-cn": "7.9.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@hono/node-server": "^2.1.6",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@xyflow/react": "^12.12.1",
    "ag-psd": "34.1.0",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.16",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.1",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.91.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
