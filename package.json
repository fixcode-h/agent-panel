{
  "name": "agent-panel",
  "version": "0.28.0",
  "private": true,
  "type": "module",
  "description": "本机 Agent 任务面板：按项目分类编排 Codex / Claude Code 等本地 Agent",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit && node scripts/i18n-check.mjs",
    "lint": "oxlint --deny-warnings && prettier --check web/src server shared scripts vite.config.ts && node scripts/rules-check.mjs && node scripts/secret-check.mjs",
    "check:secrets": "node scripts/secret-check.mjs",
    "lessons": "node scripts/lessons.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:wsl": "wsl -e bash -lc \"npm run test:e2e\"",
    "test:unit": "tsx --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"web/src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:coverage": "tsx --test --experimental-test-coverage \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@hono/node-server": "^2.1.5",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.86.0",
    "playwright": "^1.56.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
