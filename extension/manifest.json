{
  "manifest_version": 3,
  "name": "Agent 面板 · 网页生图",
  "version": "1.5.0",
  "description": "让本机的 Agent 面板用你已登录的 Gemini / ChatGPT 网页生成图片。只读取这两个网站的标签页。",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Agent 面板" },
  "icons": { "128": "icon.png" }
}
