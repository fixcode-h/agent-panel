{
  "id": "gemini",
  "name": "Gemini CLI",
  "command": "gemini",
  "npmPackage": "@google/gemini-cli",
  "brew": ["gemini-cli"],
  "docsUrl": "https://github.com/google-gemini/gemini-cli",
  "color": "#3b78e7",
  "models": [
    {
      "id": "gemini-3-pro-preview",
      "label": "Gemini 3 Pro"
    },
    {
      "id": "gemini-3-flash-preview",
      "label": "Gemini 3 Flash"
    },
    {
      "id": "gemini-2.5-pro",
      "label": "Gemini 2.5 Pro",
      "isDefault": true
    },
    {
      "id": "gemini-2.5-flash",
      "label": "Gemini 2.5 Flash"
    },
    {
      "id": "gemini-2.5-flash-lite",
      "label": "Gemini 2.5 Flash Lite"
    }
  ],
  "tiers": {
    "high": {
      "model": "gemini-3-pro-preview",
      "effort": ""
    },
    "medium": {
      "model": "gemini-2.5-pro",
      "effort": ""
    },
    "low": {
      "model": "gemini-2.5-flash",
      "effort": ""
    }
  },
  "permissions": [
    {
      "id": "auto_edit",
      "label": "自动接受改文件",
      "hint": "可以直接改文件；非交互执行时 Gemini CLI 不能请你确认，跑命令会被拦下"
    },
    {
      "id": "yolo",
      "label": "跳过所有确认",
      "hint": "可以改文件、执行任意命令，只在信任的项目里用"
    },
    {
      "id": "default",
      "label": "只读",
      "hint": "非交互执行时改文件和跑命令都会被拦下，只能读代码和分析"
    }
  ],
  "defaultPermission": "auto_edit",
  "readOnlyPermission": "default",
  "args": [
    {
      "args": ["--output-format", "stream-json"]
    },
    {
      "if": "model",
      "args": ["-m", "{model}"]
    },
    {
      "if": "permission",
      "args": ["--approval-mode", "{permission}"]
    },
    {
      "if": "resume",
      "args": ["--resume", "{resume}"]
    },
    {
      "if": "addDirs",
      "args": ["--include-directories", "{addDirs|,}"]
    }
  ],
  "output": {
    "format": "ndjson",
    "events": [
      {
        "when": {
          "type": "init"
        },
        "emit": [
          {
            "type": "session",
            "id": "$.session_id"
          },
          {
            "type": "usage",
            "model": "$.model"
          }
        ]
      },
      {
        "when": {
          "type": "message",
          "role": "user"
        },
        "emit": []
      },
      {
        "when": {
          "type": "message",
          "delta": true
        },
        "emit": [
          {
            "type": "text_delta",
            "text": "$.content"
          }
        ]
      },
      {
        "when": {
          "type": "message"
        },
        "emit": [
          {
            "type": "text",
            "text": "$.content"
          }
        ]
      },
      {
        "when": {
          "type": "tool_use"
        },
        "emit": [
          {
            "type": "tool",
            "name": "$.tool_name",
            "id": "$.tool_id",
            "input": "$.parameters"
          }
        ]
      },
      {
        "when": {
          "type": "tool_result"
        },
        "emit": [
          {
            "type": "tool_result",
            "id": "$.tool_id",
            "output": "$.output",
            "error": "$.error.message",
            "failed": "$.status != success"
          }
        ]
      },
      {
        "when": {
          "type": "error"
        },
        "emit": [
          {
            "type": "error",
            "message": "$.message"
          }
        ]
      },
      {
        "when": {
          "type": "result"
        },
        "emit": [
          {
            "type": "usage",
            "context": "$.stats.input_tokens",
            "addInput": "$.stats.input_tokens",
            "addOutput": "$.stats.output_tokens",
            "addCacheRead": "$.stats.cached"
          },
          {
            "type": "result",
            "ok": "$.status == success",
            "error": "$.error.message"
          }
        ]
      }
    ]
  },
  "features": {
    "fork": "none",
    "compact": "summary",
    "autoCompact": "panel",
    "contextWindow": 1000000
  },
  "docs": ["GEMINI.md", "AGENTS.md"],
  "docsNote": "Gemini CLI 每次启动读项目里的 GEMINI.md（可以在 settings.json 的 context.fileName 里改成也读 AGENTS.md）。",
  "globalDoc": "${GEMINI_CLI_HOME:-~}/.gemini/GEMINI.md",
  "skills": {
    "user": ["~/.gemini/skills", "~/.agents/skills"],
    "repo": [".gemini/skills", ".agents/skills"]
  },
  "commands": {
    "user": ["~/.gemini/commands"],
    "repo": [".gemini/commands"],
    "format": "toml"
  },
  "envExample": "GEMINI_API_KEY=...",
  "i18n": {
    "en": {
      "可以直接改文件；非交互执行时 Gemini CLI 不能请你确认，跑命令会被拦下": "Can edit files directly. In non-interactive mode Gemini CLI can't ask you, so shell commands are blocked",
      "只读": "Read-only",
      "非交互执行时改文件和跑命令都会被拦下，只能读代码和分析": "In non-interactive mode edits and commands are blocked; it can only read and analyze",
      "Gemini CLI 每次启动读项目里的 GEMINI.md（可以在 settings.json 的 context.fileName 里改成也读 AGENTS.md）。": "Gemini CLI reads GEMINI.md in the project on every start (set context.fileName in settings.json to also read AGENTS.md).",
      "可以改文件、执行任意命令，只在信任的项目里用": "Can edit files and run any command. Use only in trusted projects",
      "Google 已不再支持用个人账号（Gemini Code Assist for individuals）登录 Gemini CLI，个人账号登录后运行会报「no longer supported」。Google Workspace 或付费的 Code Assist 账号仍可以用账号登录；个人用户请把上面的「登录方式」切到 API，用 Gemini API Key。": "Google no longer supports signing in to Gemini CLI with a personal account (Gemini Code Assist for individuals); runs after a personal sign-in fail with \"no longer supported\". Google Workspace or paid Code Assist accounts can still sign in with an account; personal users should switch the sign-in method above to API and use a Gemini API key."
    }
  },
  "mcpStore": {
    "file": "${GEMINI_CLI_HOME:-~}/.gemini/settings.json",
    "format": "json",
    "key": "mcpServers",
    "urlKey": "httpUrl"
  },
  "mcp": {
    "files": {
      ".gemini/settings.json": {
        "mcpServers": {
          "{name}": {
            "httpUrl": "{url}",
            "trust": true,
            "timeout": 86400000
          }
        }
      }
    }
  },
  "auth": {
    "login": ["-p", "hello"],
    "loginStdin": "y\n",
    "loginEdits": [
      {
        "file": "${GEMINI_CLI_HOME:-~}/.gemini/settings.json",
        "set": {
          "security.auth.selectedType": "oauth-personal"
        }
      }
    ],
    "home": "${GEMINI_CLI_HOME:-~}/.gemini",
    "files": ["oauth_creds.json", "google_accounts.json"],
    "identity": "gemini",
    "api": {
      "protocols": ["gemini"],
      "env": {
        "GEMINI_API_KEY": "{apiKey}",
        "GOOGLE_GEMINI_BASE_URL": "{baseUrl}"
      },
      "edits": [
        {
          "file": "${GEMINI_CLI_HOME:-~}/.gemini/settings.json",
          "set": {
            "security.auth.selectedType": "gemini-api-key"
          }
        }
      ],
      "accountEdits": [
        {
          "file": "${GEMINI_CLI_HOME:-~}/.gemini/settings.json",
          "set": {
            "security.auth.selectedType": "oauth-personal"
          }
        }
      ]
    },
    "accountNote": "Google 已不再支持用个人账号（Gemini Code Assist for individuals）登录 Gemini CLI，个人账号登录后运行会报「no longer supported」。Google Workspace 或付费的 Code Assist 账号仍可以用账号登录；个人用户请把上面的「登录方式」切到 API，用 Gemini API Key。",
    "apiSources": [
      {
        "protocol": "gemini",
        "baseUrl": ["GOOGLE_GEMINI_BASE_URL"],
        "defaultBaseUrl": "https://generativelanguage.googleapis.com",
        "apiKey": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
        "models": ["GEMINI_MODEL"]
      },
      {
        "file": "${GEMINI_CLI_HOME:-~}/.gemini/.env",
        "format": "env",
        "protocol": "gemini",
        "baseUrl": ["GOOGLE_GEMINI_BASE_URL"],
        "defaultBaseUrl": "https://generativelanguage.googleapis.com",
        "apiKey": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
        "models": ["GEMINI_MODEL"]
      }
    ]
  },
  "env": {
    "GEMINI_CLI_TRUST_WORKSPACE": "true"
  }
}
